# Can't Say No environment template.
# Copy to .env and fill in values you actually need.
# No variable is required for the anonymous card product.
# Never put real secrets in this file.

# Optional. Neon/Postgres URL. Unset = in-memory PGLite.
# The card product does not query the database.
DATABASE_URL=postgres://user:password@localhost:5432/cant_say_no

# Optional. Auth is off unless this is set to something other than "false".
# Workspace default also comes from .grok/app-env.json.
VITE_AUTH_ENABLED=false

# Optional. Enables the studio Inspire action (xAI chat completions).
XAI_API_KEY=your-xai-api-key-here

# Optional. Better Auth public origin and signing secret (real auth only).
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Optional. Grok auth broker (injected on App Builder deploys).
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional. Distinguishes workspace preview from a platform deploy.
GROK_PROJECT_ID=

# Optional. Explicit Grok identity-gate origin.
GROK_GATE_ORIGIN=

# Optional. Grok viewer connectors (not used by the card product).
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Optional. Public hostname for Grok PWA metadata.
VITE_PUBLIC_HOSTNAME=

# Optional. Comma-separated STUN URLs for the unused P2P helper.
VITE_STUN_URLS=
